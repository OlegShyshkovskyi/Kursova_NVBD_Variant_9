  <DataSources>
    <DataSource Name="DataSource1">
      <DataSourceReference>DataSource1</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>87b88622-4d42-4867-ba02-5fb40ede7a1f</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>SELECT TOP 1000
    D.ActualDepartureDateTime,
    R.FlightNumber,
    Dep.City + ' - ' + Arr.City AS Route,
    D.TicketsSold,
    D.PricePerTicket,
    (D.TicketsSold * D.PricePerTicket) AS TotalRevenue
FROM dbo.Departures D
JOIN dbo.Routes R ON D.RouteID = R.RouteID
JOIN dbo.Airports Dep ON R.DepartureAirportID = Dep.AirportID
JOIN dbo.Airports Arr ON R.ArrivalAirportID = Arr.AirportID
ORDER BY D.ActualDepartureDateTime DESC</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="ActualDepartureDateTime">
          <DataField>ActualDepartureDateTime</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="FlightNumber">
          <DataField>FlightNumber</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Route">
          <DataField>Route</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="TicketsSold">
          <DataField>TicketsSold</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="PricePerTicket">
          <DataField>PricePerTicket</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="TotalRevenue">
          <DataField>TotalRevenue</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
